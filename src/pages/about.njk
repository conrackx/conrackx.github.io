{% extends "page.njk" %}
{% set page_title = "Sobre mí" %}
{% set description = bio.short %}
{% block content %}
<div style="margin-bottom: var(--space-xl);">
  <p style="font-size: var(--text-lg); color: var(--muted);">{{ bio.pitch }}</p>
</div>

<p>{{ bio.long }}</p>

<h2>Skills</h2>
<div style="display: grid; gap: var(--space-lg); margin-top: var(--space-md);">
  {% for group in skills %}
  <div>
    <h3 style="font-size: var(--text-base); color: var(--accent); margin-bottom: var(--space-xs);">{{ group.category }}</h3>
    <div style="display: flex; flex-wrap: wrap; gap: var(--space-xs);">
      {% for skill in group.items %}
      <span class="tag" title="{{ skill.evidence }}">{{ skill.name }} <span style="opacity: 0.7;">· {{ skill.level }}</span></span>
      {% endfor %}
    </div>
  </div>
  {% endfor %}
</div>
{% endblock %}
