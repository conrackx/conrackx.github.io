<div class="card proof-point">
  <div class="icon-large">{% icon "database" %}</div>
  <h3>{{ title }}</h3>
  {% if desc %}<p style="color: var(--muted);">{{ desc }}</p>{% endif %}
  {% if metric %}<p style="color: var(--accent); font-weight: 700; font-size: var(--text-xl); margin-top: var(--space-xs);">{{ metric }}</p>{% endif %}
</div>
