<footer class="site-footer">
<div class="container flex justify-between items-center flex-wrap gap-sm">
<span><span class="text-accent">/</span>{{ site.subtitle }} · {{ site.author.name }} · {{ site | currentYear }}</span>
<div class="flex gap-md">
<a href="{{ site.social.github }}" target="_blank" rel="noopener" aria-label="GitHub">
<svg class="icon"><use href="/assets/icons/sprite.svg#github"></use></svg>
</a>
<a href="{{ site.social.linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn">
<svg class="icon"><use href="/assets/icons/sprite.svg#linkedin"></use></svg>
</a>
<a href="mailto:{{ site.author.email }}" aria-label="Email">
<svg class="icon"><use href="/assets/icons/sprite.svg#mail"></use></svg>
</a>
</div>
</div>
</footer>
